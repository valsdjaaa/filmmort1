---
const modules = import.meta.glob("../../content/texts/*.md", { eager: true });

const { slug } = Astro.params;

const post = Object.values(modules).find(
  (m) => m.frontmatter.slug === slug
);

if (!post) {
  throw new Error("Post not found");
}
---

<article>
  <h1>{post.frontmatter.title}</h1>
  <post.default />
</article>
