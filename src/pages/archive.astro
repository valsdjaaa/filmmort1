---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Dinamički učitaj sve tagove iz CMS foldera
const tagFiles = import.meta.glob('../config/tags/*.md', { eager: true });

// Parsiraj frontmatter iz .md fajlova
const tagsArray = Object.entries(tagFiles).map(([path, file]) => {
  const frontmatter = file.frontmatter || {};
  
  return {
    key: frontmatter.key || path.split('/').pop().replace('.md', ''),
    label: frontmatter.label || frontmatter.key || 'Nepoznat',
    color: frontmatter.color || '#999'
  };
});

// Napravi TAGS objekat za filtere
const TAGS = {};
tagsArray.forEach(tag => {
  TAGS[tag.key.toLowerCase()] = {
    label: tag.label,
    color: tag.color
  };
});

const formatDate = (date) =>
  new Date(date).toLocaleDateString("sr-Latn-RS", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

let posts = await getCollection("texts");

posts = posts.sort(
  (a, b) => new Date(b.data.date) - new Date(a.data.date)
);
---

<BaseLayout title="Arhiva" page="archive">

  <!-- HEADER FILTERS -->
  <Fragment slot="header-filters">
    <nav class="archive-filters">
      <a href="/archive" class="filter-pill">SVE</a>

      {Object.entries(TAGS).map(([key, value]) => (
        <a
          href={`/archive?tag=${key}`}
          class="filter-pill"
          style={`--tag-color: ${value.color}`}
        >
          {value.label.toUpperCase()}
        </a>
      ))}
    </nav>
  </Fragment>

  <!-- GRID -->
  <section class="archive-grid">

    <!-- FILTER TILE -->
    <div class="archive-item archive-item--filters">
      <div class="archive-filters-grid">
        <a href="/archive" class="filter-pill">SVE</a>

        {Object.entries(TAGS).map(([key, value]) => (
          <a
            href={`/archive?tag=${key}`}
            class="filter-pill"
            style={`--tag-color: ${value.color}`}
          >
            {value.label}
          </a>
        ))}
      </div>
    </div>

    <!-- POSTOVI -->
    {posts.map((post) => {
      const postTags = (post.data.tags ?? []).map(t => t.toLowerCase());

      return (
        <a
          href={`/texts/${post.id}`}
          class="archive-item"
          data-tags={postTags.join(' ')}
          style={`--tag-color: ${TAGS[postTags[0]]?.color ?? "#999"}`}
        >
          <div class="archive-meta">
            <div class="archive-tags">
              {postTags.map((tag) => {
                const tagData = TAGS[tag] ?? {
                  label: tag.toUpperCase(),
                  color: "#999",
                };
                return (
                  <span class="archive-tag" style={`color: ${tagData.color}`}>
                    {tagData.label}
                  </span>
                );
              })}
            </div>
            <span class="archive-date">{formatDate(post.data.date)}</span>
          </div>
          <h3 class="archive-title">{post.data.title}</h3>
          {post.data.subtitle && <p class="archive-subtitle">{post.data.subtitle}</p>}
        </a>
      );
    })}
  </section>

  <script is:inline>
    (function() {
      // Sačekaj da se DOM učita
      document.addEventListener('DOMContentLoaded', function() {
        const filterPills = document.querySelectorAll('.filter-pill');
        const archiveItems = document.querySelectorAll('.archive-item:not(.archive-item--filters)');
        
        // Aktivni filteri iz URL-a
        const params = new URLSearchParams(window.location.search);
        let activeFilters = params.getAll('tag');
        
        // Funkcija za filtriranje
        function filterPosts() {
          archiveItems.forEach(item => {
            const itemTags = item.dataset.tags?.split(' ') || [];
            
            if (activeFilters.length === 0) {
              item.style.display = 'flex';
            } else {
              const shouldShow = activeFilters.some(filter => 
                itemTags.some(tag => tag === filter.toLowerCase())
              );
              item.style.display = shouldShow ? 'flex' : 'none';
            }
          });
        }
        
        // Funkcija za ažuriranje aktivnih klasa na filterima
        function updateActiveFilters() {
          filterPills.forEach(pill => {
            pill.classList.remove('active');
            const href = pill.getAttribute('href');
            
            if (href === '/archive' && activeFilters.length === 0) {
              pill.classList.add('active');
            } else {
              const match = href.match(/tag=([^&]+)/);
              if (match && activeFilters.includes(match[1])) {
                pill.classList.add('active');
              }
            }
          });
        }
        
        // Dodaj event listenere na filtere
        filterPills.forEach(pill => {
          pill.addEventListener('click', function(e) {
            e.preventDefault();
            
            const href = this.getAttribute('href');
            let newFilters = [];
            
            if (href !== '/archive') {
              const match = href.match(/tag=([^&]+)/);
              if (match) {
                const clickedTag = match[1];
                if (activeFilters.includes(clickedTag)) {
                  newFilters = activeFilters.filter(t => t !== clickedTag);
                } else {
                  newFilters = [...activeFilters, clickedTag];
                }
              }
            } else {
              newFilters = [];
            }
            
            activeFilters = newFilters;
            
            // Ažuriraj URL bez osvežavanja
            const url = new URL(window.location);
            url.searchParams.delete('tag');
            newFilters.forEach(tag => url.searchParams.append('tag', tag));
            window.history.pushState({}, '', url);
            
            // Ažuriraj aktivne klase
            updateActiveFilters();
            
            // Filtriraj postove
            filterPosts();
          });
        });
        
        // Inicijalno postavi aktivne filtere
        updateActiveFilters();
        filterPosts();
      });
    })();
  </script>

</BaseLayout>