---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Dinamički učitaj sve tagove iz CMS foldera
const tagFiles = import.meta.glob('../config/tags/*.md', { eager: true });

// Parsiraj frontmatter iz .md fajlova
const tagsArray = Object.entries(tagFiles).map(([path, file]) => {
  const frontmatter = file.frontmatter || {};
  
  return {
    key: frontmatter.key || path.split('/').pop().replace('.md', ''),
    label: frontmatter.label || frontmatter.key || 'Nepoznat',
    color: frontmatter.color || '#999'
  };
});

// Napravi TAGS objekat za filtere
const TAGS = {};
tagsArray.forEach(tag => {
  TAGS[tag.key.toLowerCase()] = {  // Čuvaj sve ključeve malim slovima
    label: tag.label,
    color: tag.color
  };
});

const formatDate = (date) =>
  new Date(date).toLocaleDateString("sr-Latn-RS", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

let posts = await getCollection("texts");

posts = posts.sort(
  (a, b) => new Date(b.data.date) - new Date(a.data.date)
);

const url = new URL(Astro.request.url);
const activeTags = url.searchParams.getAll("tag").map(t => t.toLowerCase()); // Svi aktivni tagovi mala slova

// 🔍 DEBUG: Šta imamo?
console.log('🔥 activeTags:', activeTags);
console.log('📦 TAGS keys:', Object.keys(TAGS));
console.log('🎨 TAGS objekat:', TAGS);

// Filtriranje - post mora imati BILO KOJI od aktivnih tagova (case insensitive)
if (activeTags.length > 0) {
  posts = posts.filter((post) => {
    const postTags = (post.data.tags ?? []).map(t => t.toLowerCase());
    return activeTags.some(tag => postTags.includes(tag));
  });
}
---

<BaseLayout title="Arhiva" page="archive">

  <!-- HEADER FILTERS -->
  <Fragment slot="header-filters">
    <nav class="archive-filters">

      <!-- SVE -->
      <a
        href="/archive"
        class={`filter-pill ${activeTags.length === 0 ? "active" : ""}`}
      >
        SVE
      </a>

      {Object.entries(TAGS).map(([key, value]) => {

        const isActive = activeTags.includes(key); // Sad su sva mala slova
        // 🔍 DEBUG za svaki filter
        console.log(`🔍 Filter: ${key}, aktivan: ${isActive}, activeTags: ${activeTags}`);

        const newTags = isActive
          ? activeTags.filter(t => t !== key)
          : [...activeTags, key];

        const query = newTags.length
          ? "?" + newTags.map(t => `tag=${t}`).join("&")
          : "";

        return (
          <a
            href={`/archive${query}`}
            class={`filter-pill ${isActive ? "active" : ""}`}
            style={`--tag-color: ${value.color}`}
          >
            {value.label.toUpperCase()}
          </a>
        );
      })}

    </nav>
  </Fragment>


  <!-- GRID -->
  <section class="archive-grid">

    <!-- FILTER TILE -->
    <div class="archive-item archive-item--filters">
      <div class="archive-filters-grid">
        <a
          href="/archive"
          class={`filter-pill ${activeTags.length === 0 ? "active" : ""}`}
        >
          SVE
        </a>

        {Object.entries(TAGS).map(([key, value]) => {

          const isActive = activeTags.includes(key);
          const newTags = isActive
            ? activeTags.filter(t => t !== key)
            : [...activeTags, key];
          const query = newTags.length
            ? "?" + newTags.map(t => `tag=${t}`).join("&")
            : "";

          return (
            <a
              href={`/archive${query}`}
              class={`filter-pill ${isActive ? "active" : ""}`}
              style={`--tag-color: ${value.color}`}
            >
              {value.label}
            </a>
          );
        })}
      </div>
    </div>


    <!-- POSTOVI -->
    {posts.map((post) => {

      const postTags = (post.data.tags ?? []).map(t => t.toLowerCase());

      return (
        <a
          href={`/texts/${post.id}`}
          class="archive-item"
          style={`--tag-color: ${
            TAGS[postTags[0]]?.color ?? "#999"
          }`}
        >

          <div class="archive-meta">

            <div class="archive-tags">
              {postTags.map((tag) => {

                const tagData = TAGS[tag] ?? {
                  label: tag.toUpperCase(),
                  color: "#999",
                };

                return (
                  <span
                    class="archive-tag"
                    style={`color: ${tagData.color}`}
                  >
                    {tagData.label}
                  </span>
                );
              })}
            </div>

            <span class="archive-date">
              {formatDate(post.data.date)}
            </span>

          </div>

          <h3 class="archive-title">
            {post.data.title}
          </h3>

          {post.data.subtitle && (
            <p class="archive-subtitle">
              {post.data.subtitle}
            </p>
          )}

        </a>
      );
    })}

  </section>
<script>
  // Kad se stranica učita, proveri URL parametre
  window.addEventListener('load', function() {
    console.log('Stranica učitana sa tagovima:', window.location.search);
  });
  
  // Osveži stranicu kad se promene URL parametri (kada klikneš na filter)
  window.addEventListener('popstate', function() {
    window.location.reload();
  });
  
  // Prisilno osvežavanje za sve linkove sa filter-pill klasom
  document.querySelectorAll('.filter-pill').forEach(link => {
    link.addEventListener('click', function(e) {
      // Dozvoli linku da radi svoje, ali ćemo ipak osvežiti
      setTimeout(() => {
        window.location.reload();
      }, 100);
    });
  });
</script>
</BaseLayout>