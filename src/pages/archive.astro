---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TAGS } from "../config/tags";
import { getCollection } from "astro:content";

const formatDate = (date) =>
  new Date(date).toLocaleDateString("sr-Latn-RS", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

let posts = await getCollection("texts");

posts = posts.sort((a, b) =>
  new Date(b.data.date) - new Date(a.data.date)
);

const activeTag = Astro.url.searchParams.get("tag");

if (activeTag) {
  posts = posts.filter((post) => post.data.tag === activeTag);
}
---


<BaseLayout title="Arhiva" page="archive">

  {/* FILTERI */}
  <nav class="archive-filters">
    <a
      href="/archive"
      class={`filter-pill ${!activeTag ? "active" : ""}`}
    >
      SVE
    </a>

    {Object.entries(TAGS).map(([key, value]) => (
      <a
        href={`/archive?tag=${key}`}
        class={`filter-pill ${activeTag === key ? "active" : ""}`}
        style={`--tag-color: ${value.color}`}
      >
        {value.label}
      </a>
    ))}
  </nav>

  {/* GRID */}
  <section class="archive-grid">
    {posts.map((post) => {
      const tagData = TAGS[post.tag] ?? {
        label: post.tag?.toUpperCase(),
        color: "#999",
      };

      return (
        <a
          href={`/texts/${post.slug}`}
          class="archive-item"
          style={`--tag-color: ${tagData.color}`}
        >
          <div class="archive-meta">
            <span
              class="archive-tag"
              style={`color: ${tagData.color}`}
            >
              {tagData.label}
            </span>

            <span class="archive-date">
              {formatDate(post.date)}
            </span>
          </div>

          <h3 class="archive-title">{post.title}</h3>

          {post.subtitle && (
            <p class="archive-subtitle">{post.subtitle}</p>
          )}
        </a>
      );
    })}
  </section>

</BaseLayout>
