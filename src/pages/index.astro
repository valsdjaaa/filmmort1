
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("texts"))
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 7);
---

<BaseLayout title="Film Mort" page="home">
  <section class="list">
    {posts.map(post => {
      const slug = post.id;
      return (
        <a
          href={`/texts/${slug}`}
          class={`row-link row ${post.data.tags?.[0] || ""}`}
        >
          <div class="row-inner">
            <div class="cell date">
              {new Date(post.data.date).toLocaleDateString("sr-Latn-RS", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </div>
            <div class="cell tag">
              {post.data.tags?.[0]?.toUpperCase()}
            </div>
            <div class="cell content">
              {post.data.kicker && (
                <div class="kicker">{post.data.kicker}</div>
              )}
              <div class="title">{post.data.title}</div>
              {post.data.subtitle && (
                <div class="subtitle">{post.data.subtitle}</div>
              )}
            </div>
          </div>
        </a>
      );
    })}
  </section>


</BaseLayout>