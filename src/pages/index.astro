---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TAGS } from "../config/tags";

const modules = import.meta.glob("../content/texts/*.md", { eager: true });

const posts = Object.values(modules)
  .map((mod) => {
    const filePath = mod.file;
    const slug = filePath.split("/").pop().replace(".md", "");

    return {
      ...mod.frontmatter,
      slug,
    };
  })
  .sort((a, b) => new Date(b.date) - new Date(a.date))
  .slice(0, 7);
---

<BaseLayout title="Film Mort" page="home">
  <section class="list">
    {posts.map(post => {
      const tagData = TAGS[post.tag] ?? {
        label: post.tag?.toUpperCase(),
        color: "#999"
      };

      return (
        <a
          href={`/texts/${post.slug}`}
          class="row-link row"
          style={`--tag-color: ${tagData.color}`}
        >
          <div class="row-inner">

            <div class="cell date">
              {new Date(post.date).toLocaleDateString("sr-Latn-RS", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </div>

            <div
              class="cell tag"
              style={`color: ${tagData.color}`}
            >
              {tagData.label}
            </div>

            <div class="cell content">
              {post.kicker && (
                <div class="kicker">{post.kicker}</div>
              )}

              <div class="title">{post.title}</div>

              {post.subtitle && (
                <div class="subtitle">{post.subtitle}</div>
              )}
            </div>

          </div>
        </a>
      );
    })}
  </section>
</BaseLayout>
