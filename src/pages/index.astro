---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Dinamički učitaj sve tagove iz CMS foldera
const tagFiles = import.meta.glob('../config/tags/*.md', { eager: true });

// Parsiraj frontmatter iz .md fajlova
const tagsArray = Object.entries(tagFiles).map(([path, file]) => {
  const frontmatter = file.frontmatter || {};
  
  return {
    key: frontmatter.key || path.split('/').pop().replace('.md', ''),
    label: frontmatter.label || frontmatter.key || 'Nepoznat',
    color: frontmatter.color || '#999'
  };
});

// Napravi TAGS objekat za boje i labele
const TAGS = {};
tagsArray.forEach(tag => {
  TAGS[tag.key] = {
    label: tag.label,
    color: tag.color
  };
});

let posts = await getCollection("texts");

// Sortiraj: prvo pinovani, onda po datumu
posts = posts.sort((a, b) => {
  // Pinovani idu prvi
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  
  // Zatim po datumu (noviji prvi)
  return new Date(b.data.date) - new Date(a.data.date);
});

// Uzmi prvih 7 (pinovani će ući među prvih 7 ako ih ima)
posts = posts.slice(0, 7);
---

<BaseLayout title="Film Mort" page="home">
  <section class="list">
    {posts.map(post => {
      const slug = post.id;
      const postTags = post.data.tags ?? [];
      const primaryTag = postTags[0]?.toLowerCase();
      const tagColor = TAGS[primaryTag]?.color ?? '#999';
      const tagLabel = TAGS[primaryTag]?.label ?? postTags[0]?.toUpperCase() ?? '';

      return (
        <a
          href={`/texts/${slug}`}
          class={`row-link row ${primaryTag || ""} ${post.data.pinned ? 'pinned' : ''}`}
          style={`--tag-color: ${tagColor}`}
        >
          <div class="row-inner">
            <div class="cell date">
              {post.data.pinned && <span class="pin-icon">📌</span>}
              {new Date(post.data.date).toLocaleDateString("sr-Latn-RS", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </div>
            <div class="cell tag" style={`color: ${tagColor}`}>
              {tagLabel}
            </div>
            <div class="cell content">
              {post.data.kicker && (
                <div class="kicker">{post.data.kicker}</div>
              )}
              <div class="title">
                {post.data.title}
              </div>
              <div class="subtitle">
                {post.data.subtitle ?? ""}
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </section>
</BaseLayout>