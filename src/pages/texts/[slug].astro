---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("texts");
  
  return posts.map((post) => ({
    params: {
      slug: post.id
    }
  }));
}

const { slug } = Astro.params;

const posts = await getCollection("texts");
const post = posts.find(p => p.id === slug);

if (!post) {
  throw new Error(`Post not found: ${slug}`);
}

// Uzmi renderovani HTML iz post.rendered.html
const contentHtml = post.rendered?.html || post.body;
---

<ArticleLayout title={post.data.title}>
  <article class="article">
    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>
      {post.data.subtitle && (
        <p class="article-subtitle">{post.data.subtitle}</p>
      )}
    </header>
    <div class="article-body">
      <div set:html={contentHtml} />
    </div>
  </article>
</ArticleLayout>