---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

// GENERIŠI STATIC PATHS NA OSNOVU IMENA FAJLA
export async function getStaticPaths() {
  const modules = import.meta.glob("../../content/texts/*.md", { eager: true });

  return Object.keys(modules).map((path) => {
    const slug = path.split("/").pop().replace(".md", "");

    return {
      params: { slug },
    };
  });
}

const { slug } = Astro.params;

// Učitaj ponovo (da imamo pristup sadržaju)
const modules = import.meta.glob("../../content/texts/*.md", { eager: true });

const entry = Object.entries(modules).find(([path]) => {
  const fileSlug = path.split("/").pop().replace(".md", "");
  return fileSlug === slug;
});

if (!entry) {
  throw new Error("Post not found");
}

const [, mod] = entry;
const { frontmatter, default: Content } = mod;
---

<ArticleLayout title={frontmatter.title}>

  <article class="article">

    <header class="article-header">
      <h1 class="article-title">{frontmatter.title}</h1>

      {frontmatter.subtitle && (
        <p class="article-subtitle">{frontmatter.subtitle}</p>
      )}

      {frontmatter.kicker && (
        <p class="article-kicker">{frontmatter.kicker}</p>
      )}
    </header>

    <div class="article-body">
      <Content />
    </div>

  </article>

</ArticleLayout>
