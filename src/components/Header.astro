---
const { page = "" } = Astro.props;

// Učitaj temu
import themeData from '../config/theme.json';
const theme = themeData;

// Pomoćna funkcija za boju
const getColor = (part) => {
  if (theme.prideMode) return ''; // Pride mode ima poseban CSS
  
  // Ako ima pojedinačna boja za film/mort
  const customColor = theme.customColors?.find(c => c.part === part)?.color;
  if (customColor) return customColor;
  
  // Inače koristi titleColor ili belu
  return theme.titleColor || '#ffffff';
};
---

<header class={`site-header site-header--film ${page} ${theme.prideMode ? 'pride-mode' : ''}`}>

  <div class="film-layer">
    <div class="dust dust-a"></div>
    <div class="dust dust-b"></div>
    <div class="dust dust-c"></div>
  </div>

  <div class="site-header-inner">
    <div class="site-title">
      <a href="/" class="logo">
        <span class="film" style={!theme.prideMode ? `color: ${getColor('film')};` : ''}>
          FILM
        </span>
        <span class="mort" style={!theme.prideMode ? `color: ${getColor('mort')};` : ''}>
          MORT
        </span>
      </a>
    </div>

    <nav class="site-nav">
      <a href="/archive">Arhiva</a>
      <a href="/about">About</a>
    </nav>
  </div>

</header>

<style is:global>
  /* Pride mode animacija */
  .site-header--film.pride-mode .logo .film,
  .site-header--film.pride-mode .logo .mort {
    animation: pride 8s linear infinite;
    background: linear-gradient(
      124deg,
      #ff2400, #e81d1d, #e8b71d, #e3e81d, #1de840, #1ddde8, #2b1de8, #dd00f3, #dd00f3
    );
    background-size: 1800% 1800%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @keyframes pride {
    0% { background-position: 0% 0% }
    100% { background-position: 100% 0% }
  }
</style>

<script>
const layers = [
  document.querySelector(".dust-a"),
  document.querySelector(".dust-b"),
  document.querySelector(".dust-c"),
];

const frames = Array.from({ length: 60 }, (_, i) =>
  `/film/filmflick_${String(i).padStart(5, "0")}.jpg`
);

let deck = [];
let index = 0;

function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
}

function tick() {
  if (index === 0) {
    deck = [...frames];
    shuffle(deck);
  }

  layers.forEach(layer => {
    layer.style.backgroundImage = `url(${deck[index]})`;
    index = (index + 1) % deck.length;
  });

  setTimeout(tick, 60 + Math.random() * 80);
}

tick();
</script>