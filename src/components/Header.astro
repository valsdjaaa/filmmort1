---
const { page = "" } = Astro.props;
---

<header class={`site-header site-header--film ${page}`}>

  <div class="film-layer">
    <div class="dust dust-a"></div>
    <div class="dust dust-b"></div>
    <div class="dust dust-c"></div>
  </div>

  <div class="site-header-inner">

    <div class="site-title">
      <a href="/" class="logo">
        <span class="film">FILM</span>
        <span class="mort">MORT</span>
      </a>

      <nav class="site-nav">
        {page === "archive" && (
          <>
            <a href="/archive">SVE</a>
            <a href="/archive?tag=esej">ESEJ</a>
            <a href="/archive?tag=kritika">KRITIKA</a>
            <a href="/archive?tag=film">FILM</a>
            <a href="/archive?tag=pozoriste">POZORIŠTE</a>
          </>
        )}

        <a href="/archive">Arhiva</a>
        <a href="/about">About</a>
      </nav>

    </div>

  </div>

</header>


<script>
const layers = [
  document.querySelector(".dust-a"),
  document.querySelector(".dust-b"),
  document.querySelector(".dust-c"),
];

const frames = Array.from({ length: 60 }, (_, i) =>
  `/film/filmflick_${String(i).padStart(5, "0")}.jpg`
);

let deck = [];
let index = 0;

function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
}

function tick() {
  if (index === 0) {
    deck = [...frames];
    shuffle(deck);
  }

  layers.forEach(layer => {
    layer.style.backgroundImage = `url(${deck[index]})`;
    index = (index + 1) % deck.length;
  });

  setTimeout(tick, 60 + Math.random() * 80);
}

tick();


</script>
